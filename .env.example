# 서버에서 읽는 전용 설정. 이 프로젝트 밖의 기존 DB는 사용하지 않습니다.
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-mini4
# 공공데이터포털 자동변환 OpenAPI 활용신청 후 발급받은 서비스키 (선택)
DATA_GO_KR_API_KEY=
# 향후 PostgreSQL 전환 시 전용 데이터베이스를 사용합니다 (현재 MVP는 JSON 샘플).
BIKE_DATABASE_URL=postgresql+psycopg://bike_user:change-me@localhost:5432/bike_link_analysis
