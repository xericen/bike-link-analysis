link(rel="stylesheet", href="/assets/bike-link/leaflet.css")
main.bike-page([class.embedded]="embeddedRegion")
    header.bike-header(*ngIf="!embeddedRegion")
        div.brand-area
            svg.brand-cycle(viewBox="0 0 70 50", fill="none", stroke="currentColor", stroke-width="2.6", aria-hidden="true")
                circle(cx="15", cy="34", r="12")
                circle(cx="54", cy="34", r="12")
                path(d="M15 34 27 12 39 34 15 34m24 0 9-21 6 21M24 12h9M46 12h8")
            div
                strong Bike Link Analysis
                span Team 234
        div.title-area
            h1 {{pageTitle()}}
            p 대여소 이용·이동 관계 분석 · 지역별 현황 비교 · 데이터 기반 운영 제안
        div.header-context
            span.header-city {{allRegionsSelected ? '전체 도시' : nameOf(regionId)}}
            span.header-period {{periodLabel()}}
    div.bike-workspace
        aside.bike-sidebar(*ngIf="!embeddedRegion")
            nav.bike-nav(aria-label="Bike Link 분석 메뉴")
                button(type="button", [class.active]="tab === 'dashboard'", (click)="changeTab('dashboard')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                            path(d="M4 4h16v16H4z M8 8h3v3H8z M14 8h3 M14 11h3 M8 15h3 M14 15h3")
                    | 대시보드
                button(type="button", [class.active]="tab === 'stations'", (click)="changeTab('stations')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                            path(d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z")
                    | 대여소 분석
                button(type="button", [class.active]="tab === 'network'", (click)="changeTab('network')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                            path(d="M5 6h.01 M19 6h.01 M12 18h.01 M7 7l4 9 M17 7l-4 9 M7 6h10 M5 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M19 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M12 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6")
                    | 이동 패턴 분석
                button(type="button", [class.active]="tab === 'regions'", (click)="changeTab('regions')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                            path(d="M3 7h17l-4-4 M21 17H4l4 4 M20 7l-4 4 M4 17l4-4")
                    | 도시 간 비교
                button(type="button", [class.active]="tab === 'agent'", (click)="changeTab('agent')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                            path(d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3z")
                    | AI 분석 리포트
            div.sidebar-rule
            div.sidebar-section
                h2 분석 도시
                button.city-option(type="button", [class.selected]="allRegionsSelected", [attr.aria-pressed]="allRegionsSelected", (click)="selectAllRegions()")
                    span.city-check {{allRegionsSelected ? '✓' : ''}}
                    | 전체
                button.city-option(*ngFor="let region of regions", type="button", [class.selected]="!allRegionsSelected && regionId === region.region_id", (click)="selectRegion(region.region_id)")
                    span.city-check {{!allRegionsSelected && regionId === region.region_id ? '✓' : ''}}
                    | {{region.region_name}}
            div.sidebar-section
                h2 분석 기간
                div.period-box {{periodLabel()}}
                div.period-inputs
                    label
                        span 시작일
                        input(type="date", aria-label="분석 시작일", [(ngModel)]="draftStart", [min]="minDate", [max]="maxDate", [disabled]="!minDate")
                    label
                        span 종료일
                        input(type="date", aria-label="분석 종료일", [(ngModel)]="draftEnd", [min]="minDate", [max]="maxDate", [disabled]="!maxDate")
                div.period-actions
                    button(type="button", (click)="quickPeriod(7)", [disabled]="!maxDate") 7일
                    button(type="button", (click)="quickPeriod(14)", [disabled]="!maxDate") 14일
                    button(type="button", (click)="quickPeriod(30)", [disabled]="!maxDate") 30일
                    button(type="button", (click)="applyPeriod()", [disabled]="!maxDate") 적용
                p.period-error(*ngIf="periodError", role="alert") {{periodError}}
                p.period-note {{minDate ? '선택 가능: ' + minDate + ' ~ ' + maxDate : '세종은 연간 자료만 제공'}}
            div.sidebar-foot
                span ●
                | 공식 출처 확인 자료 · 가용 범위 표시
        div.bike-content
            ng-container
                div.city-analysis-heading(*ngIf="embeddedRegion")
                    h2 {{nameOf(regionId)}}
                    p {{overview?.period_start || overview?.annual_latest?.year || '관측 기간 미확보'}} ~ {{overview?.period_end || overview?.annual_latest?.year || '관측 기간 미확보'}} · {{overview?.source_names?.join(' · ') || '공식 데이터 출처 확인 중'}}
                    p {{overview?.coverage_note}}
                p.loading(*ngIf="busy", role="status") 분석 자료를 불러오는 중입니다…
                p.error(*ngIf="error", role="alert") {{error}}

                p.empty(*ngIf="overview && overview.total_rentals === null && tab !== 'agent'") 선택 기간에 상세 이용 기록이 없습니다. 연간 통계는 별도 범위입니다.
                section.dashboard-view(*ngIf="tab === 'dashboard' && overview")
                    div.metric-grid.research-kpis
                        article.metric-card
                            span 분석 대여소
                            strong {{overview.station_count === null ? 'N/A' : (overview.station_count | number)}}
                            small 개소 · {{overview.region_name}}
                        article.metric-card
                            span 이용 기록
                            strong {{overview.total_rentals === null ? 'N/A' : (overview.total_rentals | number)}}
                            small 건 · {{overview.observed_dates?.length || 'N/A'}}일 관측
                        article.metric-card
                            span 숨은 연결 거점 후보
                            strong {{research?.counts?.low_usage_high_connectivity ?? (researchBusy ? '분석 중' : 'N/A')}}
                            small 도시 내 분포 기준 후보 · 확정 역할 아님
                        article.metric-card
                            span 불균형 후보
                            strong {{research?.counts?.persistent_imbalance ?? (researchBusy ? '분석 중' : 'N/A')}}
                            small 순유출·순유입 방향 지속성 기준
                    article.panel.findings-panel
                        div.panel-heading
                            h3 이번 분석의 핵심 발견 TOP 3
                            button.link-button(type="button", (click)="changeTab('network')") 연결 근거 보기 →
                        p.loading(*ngIf="researchBusy") 실제 이용·연결·불균형 결과를 계산 중입니다…
                        p.error(*ngIf="researchError") {{researchError}}
                        div.findings-grid
                            article.finding-card(*ngFor="let item of findings()", [ngClass]="item.tone")
                                span.role-label {{item.label}}
                                ng-container(*ngIf="item.row; else noFinding")
                                    button.station-link(type="button", (click)="inspectStation(item.row.station_id, item.row.region_id)") {{item.row.region_name || ''}} {{item.row.station_id}}
                                    p(*ngIf="item.kind === 'rank'") 이용량 {{item.row.usage_rank | number}}위 → PageRank {{item.row.pagerank_rank | number}}위
                                    p(*ngIf="item.kind === 'time'") {{item.row.peak_hour}}시 이용 비중 {{item.row.peak_hour_share * 100 | number:'1.1-2'}}%
                                    p(*ngIf="item.kind === 'flow'") 순유출 {{item.row.net_outflow | number}}건 · 방향 지속성 {{item.row.persistence_ratio * 100 | number:'1.1-1'}}%
                                    small 관측 자료에 따른 운영 검토 후보입니다.
                                ng-template(#noFinding="")
                                    p {{researchBusy ? '계산 중' : '해당 분석 후보 미확보'}}
                    article.panel(*ngIf="overview.annual_latest")
                        h3 {{overview.region_name}} 연간 이용량
                        strong {{overview.annual_latest.rental_count | number}}건 · {{overview.annual_latest.year}}년
                        p.panel-note 상세 이용·대여소·OD 데이터 미확보
                    p.coverage(*ngIf="allRegionsSelected") {{overview.coverage_note}} · 도시별 K-means·후보 판정 결과를 하나로 모아 표시합니다.
                    article.panel(*ngFor="let annual of overview.annual_separate || []")
                        h3 {{annual.region_name}} 연간 이용 통계 · 통합 이용 합계 제외
                        strong {{annual.rental_count | number}}건 · {{annual.year}}년
                    div.dashboard-main
                        article.panel.map-panel
                            div.leaflet-map([id]="'bike-leaflet-map-' + regionId", *ngIf="overview.map_stations?.length", role="img", aria-label="공공자전거 대여소 지도")
                            div.map-title {{overview.region_name}} 대여소 역할별 지도
                            div.map-key
                                strong 실제 대여소 좌표
                                span 최대 120개 위치 표본
                                small 파랑 기타/미표시 · 청록 연결 · 주황 불균형 · 보라 집중
                            p.empty(*ngIf="!overview.map_stations?.length") 위치 좌표가 확보되지 않았습니다.
                        article.panel
                            h3 주요 지표 현황
                            p.panel-note 시간대별 대여 비중 · 단위: 건
                            div.bar-chart.compact-chart(*ngIf="overview.hourly")
                                div.bar-item(*ngFor="let bar of hourBars(overview.hourly)")
                                    div.bar([style.height.%]="bar.height", [attr.title]="bar.hour + '시 · ' + bar.value + '건'")
                                    span(*ngIf="bar.hour % 4 === 0") {{bar.hour}}시
                            p.empty(*ngIf="!overview.hourly") 시간대 자료 미확보
                    div.research-bottom
                        article.panel
                            h3 주요 연결 거점 TOP 5
                            p.panel-note PageRank · 전체 유효 OD 그래프에서 계산
                            div.rank-row(*ngFor="let item of dashboardRank?.rankings | slice:0:5; let i = index")
                                span.rank {{i + 1}}
                                button.station-link(type="button", (click)="inspectStation(item.original_station_id || item.station_id, item.region_id)") {{item.station_id}}
                                strong {{item.station_name}}
                                em {{item.pagerank | number:'1.4-4'}}
                            p.empty(*ngIf="!dashboardRank?.rankings?.length") 연결 자료 미확보
                        article.panel.cluster-card
                            h3 K-means 대여소 유형
                            ng-container(*ngTemplateOutlet="clusterPlot")
                        article.panel
                            h3 시간대별 이용 패턴
                            p.panel-note 실제 관측일 × 24시간
                            div.heatmap
                                div.heatmap-row(*ngFor="let row of dashboardExtra?.heatmap")
                                    span {{row.date.slice(5)}}
                                    div.heat-cells
                                        span.heat-cell(*ngFor="let value of row.hours", [style.background]="heatColor(value)", [attr.title]="row.date + ' · ' + value + '건'")
                            p.empty(*ngIf="!dashboardExtra?.heatmap?.length") 시간대 자료 미확보
                    details.panel.legacy-details
                        summary OD 이동 흐름 및 기존 상세 지표
                        p.panel-note 실제 자료 중 상위 연결 · 동일 대여소 출발·도착 제외
                        div.od-table(*ngIf="dashboardNetwork?.available")
                            div.od-row(*ngFor="let edge of dashboardNetwork.edges")
                                span {{edge.origin_station_id}} → {{edge.destination_station_id}}
                                strong {{edge.trip_count | number}}건
                    p.dashboard-disclaimer {{overview.coverage_note}} · {{periodLabel()}} · {{overview.source_names?.join(' · ')}}

                section.station-view(*ngIf="tab === 'stations'")
                    div.section-heading
                        div
                            h2 대여소 이용 특성 분석
                            p 시간대 패턴 · 군집 유형 · 유사 대여소 · 기간별 변화 분석
                    div.station-toolbar
                        input(type="search", [(ngModel)]="stationSearch", (keyup.enter)="searchStations()", placeholder="대여소명 또는 ID 검색", aria-label="대여소 검색")
                        button.primary-button(type="button", (click)="searchStations()") 검색
                        select(aria-label="대여소 선택", (change)="openStation({station_id: $any($event.target).value})")
                            option(*ngFor="let station of stations", [value]="station.station_key || station.station_id", [selected]="(selectedStation?.station?.station_key || selectedStation?.station?.station_id) === (station.station_key || station.station_id)") {{station.region_name || ''}} {{station.station_id}} · {{station.station_name}}
                        small 검색 결과 {{stationTotal | number}}개 · 이용량 상위 50개
                    div.metric-grid.research-kpis
                        article.metric-card
                            span 선택 대여소
                            strong {{selectedStation?.station?.station_id || '선택 대기'}}
                            small 분석의 기준이 되는 대여소
                        article.metric-card
                            span 군집 유형
                            strong.kpi-text {{selectedStation?.cluster?.role || 'N/A'}}
                            small 군집 품질에 따라 해석 보류 가능
                        article.metric-card
                            span 집중 시간
                            strong {{peakHour() === null ? 'N/A' : peakHour() + '시'}}
                            small 실제 시간대별 대여량의 최댓값
                        article.metric-card
                            span 유사 대여소
                            strong {{selectedStation?.similarity?.similar?.length ? (selectedStation.similarity.similar.length > 5 ? 5 : selectedStation.similarity.similar.length) + '개' : 'N/A'}}
                            small 정규화 패턴 코사인 유사도
                    div.reference-grid
                        article.panel
                            h3 선택 대여소 핵심 해석
                            ng-container(*ngIf="selectedStation")
                                strong.selected-station {{selectedStation.station.region_name || ''}} {{selectedStation.station.station_id}}
                                p.panel-note {{selectedStation.station.station_name}}
                                p.coverage {{selectedStation.cluster?.description || '군집 분석에 필요한 이용 기록이 없습니다.'}}
                                div.detail-metrics
                                    div
                                        span 총 대여
                                        strong {{selectedStation.station.rental_count === null ? 'N/A' : (selectedStation.station.rental_count | number)}}
                                    div
                                        span 총 반납
                                        strong {{selectedStation.station.return_count === null ? 'N/A' : (selectedStation.station.return_count | number)}}
                                    div
                                        span 순유출
                                        strong {{selectedStation.station.net_outflow === null ? 'N/A' : (selectedStation.station.net_outflow | number)}}
                            p.empty(*ngIf="!selectedStation") 대여소를 선택하면 실제 분석 결과가 표시됩니다.
                        article.panel.cluster-card
                            h3 K-means 군집 정보
                            ng-container(*ngTemplateOutlet="clusterPlot")
                        article.panel
                            h3 시간대별 이용 패턴
                            p.chart-legend
                                span 대여
                                span.mint-text 반납
                            svg.line-chart(viewBox="0 0 300 110", role="img", aria-label="선택 대여소 시간대별 대여 반납 패턴")
                                path(d="M8 16H292 M8 40H292 M8 65H292 M8 90H292", stroke="#e4eefb", fill="none")
                                polyline(*ngFor="let line of stationLines()", [attr.points]="line.points", [attr.stroke]="line.color", fill="none", stroke-width="2")
                                text(x="8", y="106") 0시
                                text(x="75", y="106") 6시
                                text(x="145", y="106") 12시
                                text(x="215", y="106") 18시
                                text(x="277", y="106") 23시
                            p.panel-note 동일 축 · 단위: 건 · {{periodLabel()}}
                        article.panel
                            h3 유사 대여소 TOP 5
                            table.data-table
                                thead
                                    tr
                                        th 순위
                                        th 대여소
                                        th 코사인 유사도
                                tbody
                                    tr(*ngFor="let item of selectedStation?.similarity?.similar | slice:0:5; let i = index")
                                        td {{i + 1}}
                                        td
                                            button.station-link(type="button", (click)="openStation(item)") {{item.station_id}}
                                        td {{item.score | number:'1.3-3'}}
                            p.empty(*ngIf="!selectedStation?.similarity?.similar?.length") 비교할 이용 기록이 없습니다.
                    div.research-bottom
                        article.panel
                            h3 최근 7일 vs 30일 패턴 비교
                            button.link-button(type="button", (click)="loadHistory()", [disabled]="historyBusy || !selectedStation") {{historyBusy ? '기간별 분석 계산 중…' : '기간별 실제 분석 불러오기'}}
                            div.history-chart(*ngIf="history")
                                div(*ngFor="let row of historyBars()")
                                    i([style.height.%]="row.height", [attr.title]="row.days + '일 창 · 일평균 ' + row.mean + '건'")
                                    span {{row.days}}일
                            p.panel-note(*ngIf="history") 단위: 관측일당 평균 대여 건수 · 비교 창은 선택 기간 안으로 제한
                            div.history-row(*ngFor="let item of history?.windows")
                                strong {{item.days}}일
                                span {{item.rental_count | number}}건
                                span 집중 {{item.peak_hour}}시
                                small {{item.date_start}} ~ {{item.date_end}} · {{item.confidence_warning || '관측일 충족'}}
                        article.panel
                            h3 기간별 역할 변화
                            p(*ngIf="!history") 왼쪽에서 기간별 분석을 실행하면 표시됩니다.
                            p(*ngFor="let item of history?.windows") {{item.days}}일: {{item.cluster_role || 'N/A'}} · 가중 연결 {{item.weighted_degree_rank || 'N/A'}}위
                            p.panel-note {{history?.message || '군집 번호만으로 같은 역할을 단정하지 않습니다.'}}
                        article.panel
                            h3 분석 해석 요약
                            p.coverage 실제 수치로 확인한 이용 패턴과 연결 특성을 운영 검토에 활용하세요. 재고량·재배치 자료 없이 자전거 부족이나 운영 효과를 확정할 수 없습니다.
                            button.primary-button(type="button", (click)="changeTab('network')") 이동 패턴 분석으로 이동 →
                    details.panel
                        summary 대여소 전체 검색 목록
                        div.station-list
                            button.station-row(*ngFor="let station of stations", type="button", (click)="openStation(station)")
                                span {{station.region_name || ''}} {{station.station_id}} · {{station.station_name}}
                                em {{station.rental_count | number}}건
                    p.observed {{periodLabel()}} · {{selectedStation?.source?.source_names?.join(' · ')}} · 전체 이용량과 정규화 패턴은 다른 지표입니다.

                section.network-view(*ngIf="tab === 'network'")
                    div.section-heading
                        div
                            h2 이동 패턴 분석
                            p OD 연결 구조 · 불균형 · 숨은 연결 거점 분석
                    div.metric-grid.research-kpis
                        article.metric-card
                            span 전체 OD 연결
                            strong {{network?.available ? (network.edge_count | number) : 'N/A'}}
                            small 지역 내 실제 연결 관계
                        article.metric-card
                            span 표시 연결
                            strong {{network?.available ? network.edges.length : 'N/A'}}
                            small PageRank 상위 노드 사이의 상위 20개
                        article.metric-card
                            span 숨은 연결 거점 후보
                            strong {{research?.counts?.low_usage_high_connectivity ?? 'N/A'}}
                            small 이용량 대비 중심성 순위 차이
                        article.metric-card
                            span 불균형 후보
                            strong {{research?.counts?.persistent_imbalance ?? 'N/A'}}
                            small 데이터 분포·지속성 기준
                    article.panel
                        div.panel-heading
                            h3 핵심 발견
                            span.source-pill {{network?.period_start}} ~ {{network?.period_end}}
                        p.loading(*ngIf="researchBusy") 후보의 실제 근거를 계산 중입니다…
                        div.findings-grid
                            article.finding-card(*ngFor="let item of findings()", [ngClass]="item.tone")
                                span.role-label {{item.label}}
                                strong {{item.row?.region_name || ''}} {{item.row?.station_id || '미확보'}}
