                            h3 주요 OD 연결 TOP 10
                            div.od-row(*ngFor="let edge of network?.edges | slice:0:10")
                                span {{displayStationId(edge.origin_station_id)}} → {{displayStationId(edge.destination_station_id)}}
                                strong {{edge.trip_count | number}}건
                        article.panel
                            h3 해석 가이드
                            p.coverage 연결 중심성이 높은 대여소는 이용량이 많다는 의미와 반드시 같지 않으며, 이동 네트워크에서 중요한 연결 역할을 수행할 수 있습니다.
                            p.panel-note 매개 중심성은 {{centrality?.betweenness_sample_nodes || 'N/A'}}개 노드 표본 근사입니다. 서울은 집계 OD, 대전은 개별 Trip입니다.
                    p.coverage(*ngIf="allRegionsSelected") 서울·대전 공통 기간의 통합 그래프입니다. 도시 간 이동 간선은 없으며 세종 상세 OD는 2025년10월로 공통2026년10월 네트워크에 합산하지 않습니다.
                    p.observed {{network?.period_start}} ~ {{network?.period_end}} · {{network?.source_names?.join(' · ')}}

                section.regions-view(*ngIf="tab === 'regions'")
                    div.section-heading
                        div
                            h2 도시 간 비교
                            p 공통 기간 비교 · 시간대 비율 · 요일 비중 · 세종 연간 추세
                    div.compare-controls
                        button(*ngFor="let region of regions", type="button", [class.selected]="compareRegions.includes(region.region_id)", (click)="toggleCompareRegion(region.region_id)") {{compareRegions.includes(region.region_id) ? '✓ ' : '+ '}}{{region.region_name}}
                        small 현재 {{compareRegions.length}}개 도시
                    div.metric-grid.research-kpis
                        article.metric-card
                            span 비교 도시 수
                            strong {{selectedCompareItems().length}}개
                        article.metric-card
                            span 상세 OD 지원
                            strong 서울 · 대전
                        article.metric-card
                            span 공통 분석 기간
                            strong.kpi-text {{compare?.common_start || 'N/A'}} ~ {{compare?.common_end || 'N/A'}}
                        article.metric-card
                            span 세종 지원 범위
                            strong.kpi-text 연간 추세
                    article.panel
                        h3 비교 해석 원칙
                        p.coverage 서울 집계 OD와 대전 개별 Trip은 원본 단위가 다릅니다. 총량의 단순 비교 대신 공통 관측 기간의 시간대·요일 비율을 살펴봅니다. 세종의 연간 통계는 별도입니다.
                    div.reference-grid
                        article.panel(*ngIf="compareRegions.includes('seoul') && compareRegions.includes('daejeon')")
                            h3 시간대 이용 비율 비교
                            p.chart-legend
                                span(*ngFor="let line of comparisonLines()", [style.color]="line.color") {{line.name}}
                            svg.line-chart(viewBox="0 0 300 110", role="img", aria-label="공통 기간 도시별 시간대 이용 비율")
                                path(d="M8 16H292 M8 40H292 M8 65H292 M8 90H292", stroke="#e4eefb", fill="none")
                                polyline(*ngFor="let line of comparisonLines()", [attr.points]="line.points", [attr.stroke]="line.color", fill="none", stroke-width="2")
                                text(x="8", y="106") 0시
                                text(x="145", y="106") 12시
                                text(x="277", y="106") 23시
                            p.panel-note {{compare?.common_start}} ~ {{compare?.common_end}} · 도시별 대여 합계 대비 비율(%) · 동일 축
                        article.panel(*ngIf="compareRegions.includes('seoul') && compareRegions.includes('daejeon')")
                            h3 요일별 이용 비중 비교
                            div.weekday-chart
                                div.weekday-group(*ngFor="let row of weekdayRows()")
                                    div.weekday-bars
                                        i(*ngFor="let value of row.values; let i = index", [style.height.%]="value === null ? 0 : value * 4", [style.background]="i ? '#13b99b' : '#2787f5'", [attr.title]="(i ? '대전' : '서울') + ' ' + row.name + '요일 · ' + value + '%'")
                                    span {{row.name}}
                            p.panel-note 공통 기간 · 도시별 전체 대여 대비 요일 비중(%) · 서울 파랑 / 대전 청록
                        article.panel
                            h3 지역별 데이터 및 분석 범위
                            div.region-summary(*ngFor="let item of selectedCompareItems()")
                                strong {{item.region_name}}
                                span {{item.period_start || '연간 자료'}} ~ {{item.period_end || '연간 자료'}}
                                small 대여소 {{item.station_count === null ? 'N/A' : item.station_count}} · OD {{item.has_od ? '가능' : '미확보'}}
                                p {{item.coverage_note}}
                        article.panel(*ngIf="compareRegions.includes('sejong')")
                            h3 세종 연간 이용 추세
                            svg.line-chart(viewBox="0 0 300 110", role="img", aria-label="세종 연도별 실제 이용량 추세")
                                path(d="M8 90H292", stroke="#d5e4f8", fill="none")
                                polyline([attr.points]="patternPoints(annualValues())", stroke="#2787f5", fill="none", stroke-width="2")
                            div.annual-labels
                                span(*ngFor="let row of annualRows()") {{row.year}}{{row.complete_year ? '' : '*'}}
                            p.panel-note 단위: 건 · *는 부분 연도, 완결 연도와 직접 비교 금지
                    article.panel
                        h3 공통 기간 K-means 군집별 대여소 분포
                        p.panel-note 군집 번호는 도시 간 동일 역할을 뜻하지 않습니다. 낮은 분리도는 유형 해석을 보류합니다.
                        div.reference-grid
                            div(*ngFor="let item of selectedClusterCities()")
                                strong {{item.region_name}} · {{item.period_start}} ~ {{item.period_end}}
                                div.distribution-row(*ngFor="let cluster of item.clusters")
                                    span 군집 {{cluster.cluster_id + 1}} · {{cluster.role}}
                                    div.distribution-track
                                        i([style.width.%]="clusterShare(cluster,item)")
                                    strong {{cluster.station_count | number}}개
                        p.loading(*ngIf="!comparisonClusters") 공통 기간 군집 결과를 불러오는 중입니다…
                    details.panel
                        summary 지역별 원본 총량과 상세 지표
                        div.compare-grid
                            article.panel(*ngFor="let item of selectedCompareItems()")
                                h3 {{item.region_name}}
                                p {{item.total_rentals === null ? 'N/A' : (item.total_rentals | number)}}건 · {{item.observed_dates?.length || 'N/A'}}일
                                p 대여소당 평균 {{item.average_per_station === null ? 'N/A' : (item.average_per_station | number:'1.1-2')}}건
                    p.observed 공통 관측 범위라도 운영방식·모집단·집계 정의가 달라 성과 순위를 뜻하지 않습니다.

                section.agent-view(*ngIf="tab === 'agent'")
                    div.section-heading
                        div
                            h2 AI 분석 리포트
                            p Upstage Solar 기반 근거 중심 분석 · 실제 도구 결과로 해석
                    article.panel.report-summary(*ngIf="answer?.report")
                        div.panel-heading
                            h3 실제 도구 근거 요약
                            span.source-pill {{answer.analysis_context?.date_start}} ~ {{answer.analysis_context?.date_end}}
                        div.report-facts
                            article(*ngFor="let finding of answer.report.key_findings")
                                span {{finding.label}}
                                strong {{finding.value | number:'1.0-7'}} {{finding.unit}}
                        p.panel-note 사용 알고리즘: {{answer.report.algorithms?.join(' · ')}}
                        p.panel-note {{answer.model}} · 확인된 사용 토큰 {{answer.usage?.total_tokens | number}}
                        p.error(*ngIf="answer.usage_complete === false") 일부 요청의 사용량이 반환되지 않았습니다. 표시 토큰은 확인된 하한이며 전체 청구량은 미확인입니다.
                        p.error(*ngIf="answer.llm_status === 'incomplete'") Solar 최종 요약을 완료하지 못했습니다. 실제 실행한 도구 결과를 표시합니다.
                        p.error(*ngIf="!answer.grounding_validation?.passed || !answer.station_validation?.passed || answer.semantic_validation?.passed === false") 자유 서술의 수치·대여소 ID 또는 일별 최대·최소 주장을 검증하지 못했습니다. 근거 카드와 원본 도구 결과를 우선 확인하세요.
                        div.reference-grid
                            div
                                h3 운영 검토 대상
                                article.review-action(*ngFor="let item of answer.report.recommendations")
                                    strong {{item.feature}}
                                    p {{item.evidence}}
                                    p {{item.action}}
                                    small 추가 확인: {{item.validation}}
                                p.empty(*ngIf="!answer.report.recommendations?.length") 효과를 뒷받침할 운영 제안 근거가 부족합니다.
                            div
                                h3 추가 검증 및 데이터 한계
                                p.panel-note(*ngFor="let note of answer.report.limitations") • {{note}}
                                h3 데이터 출처
                                a.report-source(*ngFor="let source of answer.report.sources", [href]="source.source_url", target="_blank", rel="noopener") {{source.dataset_name}} ↗
                    div.agent-layout
                        article.panel.agent-chat
                            h3 도구 기반 질문 실행
                            div.question-presets
                                button(type="button", [disabled]="busy", (click)="runQuestion('현재 선택 기간의 앵커 기준 취약 대여소 상위 5곳까지, 확보된 후보 수와 한계를 근거로 알려줘.')") 연계 취약 대여소 상위 5곳까지
                                button(type="button", [disabled]="busy", (click)="runQuestion('대여소 확충 우선 순위 상위 5곳까지 점수 근거와 함께 알려줘.')") 대여소 확충 상위 5곳까지
                                button(type="button", [disabled]="busy", (click)="runQuestion('현재 도시의 앵커 연계 이용이 가장 많은 시간대를 실제 자료로 알려줘.')") 앵커 연계 이용이 가장 많은 시간대
                            div.chat-stream
                                p.empty(*ngIf="!answer && !busy") 질문을 입력하면 실제 분석 도구의 근거를 확인해 보고서를 생성합니다.
                                p.loading.agent-loading(*ngIf="busy", role="status", aria-live="polite")
                                    span.loading-spinner(aria-hidden="true")
                                    |  실제 분석 도구 실행·Solar 답변 생성 중입니다. 최대 약 100초가 걸릴 수 있습니다.
                                div.chat-message.user(*ngIf="lastQuestion")
                                    div.chat-bubble
                                        p {{lastQuestion}}
                                div.chat-message.bot(*ngIf="answer")
                                    div.chat-bubble.answer
                                        strong {{answer.answer_basis === 'tool_summary' ? '실제 도구 기반 요약' : 'Solar 자유 서술·해석'}}
                                        p {{displayText(answer.answer)}}
                                        details(*ngIf="answer.solar_answer")
                                            summary 검증 보류된 Solar 원문 보기
                                            p {{answer.solar_answer}}
                            div.chat-composer
                                input(type="text", [(ngModel)]="question", (keyup.enter)="ask()", placeholder="검토할 대여소 또는 분석 질문을 입력하세요", aria-label="분석 질문")
                                button(type="button", [disabled]="busy || !question.trim()", (click)="ask()", aria-label="메시지 보내기") {{busy ? '…' : '↑'}}
                        aside.panel.evidence-panel
                            h3 분석 근거 및 사용 도구
                            p.empty(*ngIf="!answer") 실제 실행된 도구만 여기에 표시됩니다.
                            details(*ngFor="let evidence of answer?.evidence; let i = index")
                                summary {{i + 1}}. {{evidence.tool}} · {{evidence.initiator === 'solar' ? 'Solar 선택' : '서버 근거 보강'}}
                                pre {{evidence.result | json}}
                            h3 해석상 주의사항
                            p.coverage 관측 기간·대여소 ID·출처를 함께 확인하세요. 확인되지 않은 재고 부족이나 개선 효과를 단정할 수 없습니다.

                ng-template(#clusterPlot="")
                    p.panel-note {{dashboardExtra?.selected_k || 'N/A'}}개 군집 · Silhouette {{dashboardExtra?.silhouette ?? 'N/A'}} · {{dashboardExtra?.quality === 'low' ? '분리도 낮음: 유형 해석 보류' : '시간대 비율 분포'}}
                    svg.scatter(viewBox="0 0 100 100", role="img", aria-label="대여소 군집 분포")
                        path(d="M8 10V90H94", stroke="#9fb2cc", stroke-width=".5", fill="none")
                        circle(*ngFor="let point of dashboardExtra?.cluster_points", [attr.cx]="point.px", [attr.cy]="point.py", r="1.25", [attr.fill]="['#ef5c71','#f0b835','#24c99b','#4e9ff4','#9d79e9'][point.cluster_id % 5]", fill-opacity=".8")
                    p.panel-note(*ngIf="dashboardExtra?.cluster_scope") {{dashboardExtra.cluster_scope}}
                    div.cluster-representative(*ngFor="let row of dashboardExtra?.cluster_representatives")
                        strong {{row.label}}
                        svg.mini-pattern(viewBox="0 0 300 110", role="img", [attr.aria-label]="row.label + ' 시간대별 비중'")
                            polyline([attr.points]="patternPoints(row.hourly)", stroke="#1984f4", fill="none", stroke-width="2")
                        small 0~23시 대여 비중 · 각 군집 내 합계 100%
                    button.link-button(type="button", (click)="loadStability()", [disabled]="stabilityBusy") {{stabilityBusy ? '군집 안정성 계산 중…' : '7·14·30일 군집 안정성 검증'}}
                    div.stability-panel(*ngFor="let result of stabilityRegions()")
                        strong {{result.region_name}}
                        p.panel-note(*ngFor="let row of result.windows") {{row.days}}일 · {{row.observed_day_count}}일 관측 · k={{row.selected_k || 'N/A'}} · {{row.confidence_warning || row.quality}}
                        p.panel-note(*ngFor="let score of result.comparisons") {{score.left_days}}↔{{score.right_days}}일 ARI {{score.ari ?? 'N/A'}} · 공통 {{score.common_station_count}}개
                    p.panel-note {{dashboardExtra?.cluster_count || 'N/A'}}개 분석 대여소 · 오전/오후 시간대 비율 · 군집은 인과적 역할이 아님
