                        path(d="M8 10V90H94", stroke="#9fb2cc", stroke-width=".5", fill="none")
                        circle(*ngFor="let point of dashboardExtra?.cluster_points", [attr.cx]="point.px", [attr.cy]="point.py", r="1.25", [attr.fill]="['#ef5c71','#f0b835','#24c99b','#4e9ff4','#9d79e9'][point.cluster_id % 5]", fill-opacity=".8")
                    p.panel-note(*ngIf="dashboardExtra?.cluster_scope") {{dashboardExtra.cluster_scope}}
                    div.cluster-representative(*ngFor="let row of dashboardExtra?.cluster_representatives")
                        strong {{row.label}}
                        svg.mini-pattern(viewBox="0 0 300 110", role="img", [attr.aria-label]="row.label + ' 시간대별 비중'")
                            polyline([attr.points]="patternPoints(row.hourly)", stroke="#1984f4", fill="none", stroke-width="2")
                        small 0~23시 대여 비중 · 각 군집 내 합계 100%
                    button.link-button(type="button", (click)="loadStability()", [disabled]="stabilityBusy") {{stabilityBusy ? '군집 안정성 계산 중…' : '7·14·30일 군집 안정성 검증'}}
                    div.stability-panel(*ngFor="let result of stabilityRegions()")
                        strong {{result.region_name}}
                        p.panel-note(*ngFor="let row of result.windows") {{row.days}}일 · {{row.observed_day_count}}일 관측 · k={{row.selected_k || 'N/A'}} · {{row.confidence_warning || row.quality}}
                        p.panel-note(*ngFor="let score of result.comparisons") {{score.left_days}}↔{{score.right_days}}일 ARI {{score.ari ?? 'N/A'}} · 공통 {{score.common_station_count}}개
                    p.panel-note {{dashboardExtra?.cluster_count || 'N/A'}}개 분석 대여소 · 오전/오후 시간대 비율 · 군집은 인과적 역할이 아님
