link(rel="stylesheet", href="/assets/bike-link/leaflet.css")
main.bike-page([class.embedded]="embeddedRegion")
    header.bike-header(*ngIf="!embeddedRegion")
        div.brand-area
            svg.brand-cycle(viewBox="0 0 70 50", fill="none", stroke="currentColor", stroke-width="2.6", aria-hidden="true")
                circle(cx="15", cy="34", r="12")
                circle(cx="54", cy="34", r="12")
                path(d="M15 34 27 12 39 34 15 34m24 0 9-21 6 21M24 12h9M46 12h8")
            div
                strong Bike Link Analysis
                span Team 234
        div.title-area
            h1 공유자전거, 대중교통 연결 공백을 얼마나 메우는가
            p 정류장 연계 분석 · 취약 구간 탐지 · 확충·재배치 후보 제안
        div.header-context
            span.header-city {{allRegionsSelected ? '전체 도시' : nameOf(regionId)}}
            span.header-period {{periodLabel()}}
    div.bike-workspace
        aside.bike-sidebar(*ngIf="!embeddedRegion")
            nav.bike-nav(aria-label="Bike Link 분석 메뉴")
                button(type="button", [class.active]="tab === 'dashboard'", (click)="changeTab('dashboard')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                            path(d="M4 4h16v16H4z M8 8h3v3H8z M14 8h3 M14 11h3 M8 15h3 M14 15h3")
                    | 연계 보완 대시보드
                button(type="button", [class.active]="tab === 'vulnerability'", (click)="changeTab('vulnerability')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", aria-hidden="true")
                            circle(cx="12", cy="12", r="8")
                            path(d="m15 8-2 6-5 2 2-6z")
                    | 취약 구간 & 개선 후보
                button(type="button", [class.active]="tab === 'stations'", (click)="changeTab('stations')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                            path(d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z")
                    | 대여소 분석
                button(type="button", [class.active]="tab === 'network'", (click)="changeTab('network')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                            path(d="M5 6h.01 M19 6h.01 M12 18h.01 M7 7l4 9 M17 7l-4 9 M7 6h10 M5 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M19 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M12 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6")
                    | 이동 패턴 분석
                button(type="button", [class.active]="tab === 'regions'", (click)="changeTab('regions')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                            path(d="M3 7h17l-4-4 M21 17H4l4 4 M20 7l-4 4 M4 17l4-4")
                    | 도시 간 비교
                button(type="button", [class.active]="tab === 'agent'", (click)="changeTab('agent')")
                    span.nav-icon
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                            path(d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3z")
                    | AI 분석 리포트
            div.sidebar-rule
            div.sidebar-section
                h2 분석 도시
                button.city-option(type="button", [class.selected]="allRegionsSelected", [attr.aria-pressed]="allRegionsSelected", (click)="selectAllRegions()")
                    span.city-check {{allRegionsSelected ? '✓' : ''}}
                    | 전체
                button.city-option(*ngFor="let region of regions", type="button", [class.selected]="!allRegionsSelected && regionId === region.region_id", (click)="selectRegion(region.region_id)")
                    span.city-check {{!allRegionsSelected && regionId === region.region_id ? '✓' : ''}}
                    | {{region.region_name}}
            div.sidebar-section
                h2 분석 기간
                div.period-box {{periodLabel()}}
                div.period-inputs
                    label
                        span 시작일
                        input(type="date", aria-label="분석 시작일", [(ngModel)]="draftStart", [min]="minDate", [max]="maxDate", [disabled]="!minDate")
                    label
                        span 종료일
                        input(type="date", aria-label="분석 종료일", [(ngModel)]="draftEnd", [min]="minDate", [max]="maxDate", [disabled]="!maxDate")
                div.period-actions
                    button(type="button", (click)="quickPeriod(7)", [disabled]="!maxDate") 7일
                    button(type="button", (click)="quickPeriod(14)", [disabled]="!maxDate") 14일
                    button(type="button", (click)="quickPeriod(30)", [disabled]="!maxDate") 30일
                    button(type="button", (click)="applyPeriod()", [disabled]="!maxDate") 적용
                p.period-error(*ngIf="periodError", role="alert") {{periodError}}
                p.period-note {{minDate ? '선택 가능: ' + minDate + ' ~ ' + maxDate : '세종은 연간 자료만 제공'}}
            div.sidebar-foot
                span ●
                | 공식 출처 확인 자료 · 가용 범위 표시
        div.bike-content
            ng-container
                div.city-analysis-heading(*ngIf="embeddedRegion")
                    h2 {{nameOf(regionId)}}
                    p {{overview?.period_start || overview?.annual_latest?.year || '관측 기간 미확보'}} ~ {{overview?.period_end || overview?.annual_latest?.year || '관측 기간 미확보'}} · {{overview?.source_names?.join(' · ') || '공식 데이터 출처 확인 중'}}
                    p {{overview?.coverage_note}}
                p.loading(*ngIf="busy && tab !== 'agent'", role="status") 분석 자료를 불러오는 중입니다…
                p.error(*ngIf="error", role="alert") {{error}}
                article.panel(*ngIf="unprocessed && !busy", role="status")
                    h3 이 도시·기간은 아직 데이터 미처리
                    p 선택 기간의 집계가 준비되지 않았습니다. 이용 가능한 기간을 직접 선택해 이동하세요.
                    button.link-button(*ngFor="let period of preparedPeriods", type="button", (click)="usePreparedPeriod(period)") {{period.start}} ~ {{period.end}} 보기
                    p(*ngIf="!preparedPeriods.length") 현재 이용 가능한 집계 기간이 없습니다. 데이터 갱신 후 다시 확인해 주세요.

                p.empty(*ngIf="overview && overview.total_rentals === null && tab !== 'agent'") 선택 기간에 상세 이용 기록이 없습니다. 연간 통계는 별도 범위입니다.
                section.dashboard-view(*ngIf="tab === 'dashboard' && overview")
                    div.goal-intro
                        div
                            h2 정류장과 자전거를 함께 보면, 어디까지 닿을까
                            p 정류장 접근 공백과 실제 자전거 이용을 함께 살펴봅니다.
                        button.primary-button(type="button", (click)="changeTab('vulnerability')") 취약 구간·개선 후보 보기 →
                    div.metric-grid.goal-kpis
                        article.metric-card
                            span {{regionId === 'sejong' && !allRegionsSelected ? 'BRT 정류장 300m 내 대여소 비율' : '지하철역 300m 내 대여소 비율'}}
                            strong {{percent(goalMetric('anchor_300m_ratio'))}}
                            small 앵커 거리 확보 대여소 {{goalMetric('subway_station_count') ?? 0 | number}}개 기준
                        article.metric-card
                            span 앵커 500m 밖 이용 대여소
                            strong {{goalMetric('outside_500m_active_count') === null ? 'N/A' : (goalMetric('outside_500m_active_count') | number)}}
                            small 개소 · 직선거리 500m 초과 + 실제 대여
                        article.metric-card
                            span {{regionId === 'sejong' && !allRegionsSelected ? 'BRT 앵커 연계 이동 비중' : '역 연계 이동 비중'}}
                            strong {{percent(goalMetric('linked_trip_share'))}}
                            small 출발·도착 중 한쪽 이상이 해당 앵커 300m 이내
                        article.metric-card
                            span 앵커 접근 공백 보완율
                            strong {{percent(coverageIncrease())}}
                            small 앵커 500m 밖 행정면적 중 보완되는 비중
                    p.coverage(*ngIf="regionId === 'sejong' && !allRegionsSelected") 세종은 지하철 없이 BRT가 대중교통 축입니다. 세종 2025-10 이용 기록 · 위치는 2026-05 마스터 연결
                    p.panel-note 800~1500m 첫·끝마일 대여소 {{goalMetric('first_last_mile_count') ?? 'N/A'}}개 · 일반 정류장(버스 포함) 500m 밖 {{goalMetric('reference_all_stops_outside500') ?? 'N/A'}}개는 보조 참고입니다. 기존 약 0.13% 등의 수치는 일반 버스 포함 정류장 기준 면적 증가율=(연계 면적−기준 커버 면적)/기준 커버 면적, 대표 보완율은 기준 커버 밖 행정면적을 분모로 합니다.
                    article.panel(*ngIf="overview.annual_latest")
                        h3 {{overview.region_name}} 연간 이용량
                        strong {{overview.annual_latest.rental_count | number}}건 · {{overview.annual_latest.year}}년
                    article.panel(*ngFor="let annual of overview.annual_separate || []")
                        h3 {{annual.region_name}} 연간 이용 통계 · 통합 이용 합계 제외
                        strong {{annual.rental_count | number}}건 · {{annual.year}}년
                    div.dashboard-main
                        div.transit-map-block
                            label.transit-layer-toggle
                                input(type="checkbox", [checked]="showTransitStops", (change)="toggleTransitStops()")
                                |  도시별 앵커 500m 커버 영역 표시
                            article.panel.map-panel
                                div.leaflet-map([id]="mapKey + '-dashboard'", *ngIf="overview.map_stations?.length || transitLinkage?.map_stops?.length", role="img", aria-label="정류장 커버 영역과 공유자전거 보완 관계 지도")
                                div.map-title {{overview.region_name}} 대중교통·자전거 보완 관계
                                div.map-key
                                    strong 정류장 접근 공백과 실제 이용
                                    span 대여소 최대 300개 표본 + 취약 후보 전체
                                    small 음영은 전체 정류장 커버 영역 · 행정 경계 내
                                    div.coverage-legend
                                        span.inside 커버 내
                                        span.outside 커버 밖
                                        span.vulnerable 취약 후보
                                p.empty(*ngIf="!overview.map_stations?.length") 대여소 좌표 미확보
                        article.panel
                            h3 시간대별 역 연계 이동 비중
                            p.panel-note 한쪽 이상 역 300m 내 OD / 해당 시간 전체 OD · 실제 환승 아님
                            div.bar-chart.compact-chart(*ngIf="transitLinkage?.hourly_station_linkage")
                                div.bar-item(*ngFor="let bar of linkageBars()")
                                    div.bar([style.height.%]="bar.height", [attr.title]="bar.hour + '시 · ' + percent(bar.linkage_share)")
                                    span(*ngIf="bar.hour % 4 === 0") {{bar.hour}}시
                            p.empty(*ngIf="!transitLinkage?.hourly_station_linkage") 이 도시·기간의 역 연계 시간대 자료 미확보
                    div.section-heading.network-depth-heading
                        div
                            h2 네트워크 심층 분석
                            p 이용량·PageRank·불균형·군집은 연계 후보를 검토하는 보조 근거입니다.
                    div.metric-grid.research-kpis
                        article.metric-card
                            span 분석 대여소
                            strong {{overview.station_count === null ? 'N/A' : (overview.station_count | number)}}
                            small 개소 · {{overview.region_name}}
                        article.metric-card
                            span 이용 기록
                            strong {{overview.total_rentals === null ? 'N/A' : (overview.total_rentals | number)}}
                            small 건 · {{overview.observed_dates?.length || 'N/A'}}일 관측
                        article.metric-card
                            span 숨은 연결 거점 후보
                            strong {{research?.counts?.low_usage_high_connectivity ?? (researchBusy ? '분석 중' : 'N/A')}}
                            small 도시 내 분포 기준 후보 · 확정 역할 아님
                        article.metric-card
                            span 불균형 후보
                            strong {{research?.counts?.persistent_imbalance ?? (researchBusy ? '분석 중' : 'N/A')}}
                            small 순유출·순유입 방향 지속성 기준
                    article.panel.findings-panel
                        div.panel-heading
                            h3 이번 분석의 핵심 발견 TOP 3
                            button.link-button(type="button", (click)="changeTab('network')") 연결 근거 보기 →
                        p.loading(*ngIf="researchBusy") 저장된 이용·연결·불균형 분석 결과를 불러오는 중입니다…
                        p.error(*ngIf="researchError") {{researchError}}
                        div.findings-grid
                            article.finding-card(*ngFor="let item of findings()", [ngClass]="item.tone")
                                span.role-label {{item.label}}
                                ng-container(*ngIf="item.row; else noFinding")
                                    button.station-link(type="button", (click)="inspectStation(item.row.station_id, item.row.region_id)") {{item.row.region_name || ''}} {{displayStationId(item.row.station_id)}}
                                    p(*ngIf="item.kind === 'rank'") 이용량 {{item.row.usage_rank | number}}위 → PageRank {{item.row.pagerank_rank | number}}위
                                    p(*ngIf="item.kind === 'time'") {{item.row.peak_hour}}시 이용 비중 {{item.row.peak_hour_share * 100 | number:'1.1-2'}}%
                                    p(*ngIf="item.kind === 'flow'") {{flowLabel(item.row.net_outflow)}} · 방향 지속성 {{item.row.persistence_ratio * 100 | number:'1.1-1'}}%
                                    small 관측 자료에 따른 운영 검토 후보입니다.
                                ng-template(#noFinding="")
                                    p {{researchBusy ? '불러오는 중' : '해당 분석 후보 미확보'}}
                    div.research-bottom
                        article.panel
                            h3 주요 연결 거점 TOP 5
                            p.panel-note PageRank · 전체 유효 OD 그래프에서 계산
                            div.rank-row(*ngFor="let item of dashboardRank?.rankings | slice:0:5; let i = index")
                                span.rank {{i + 1}}
                                button.station-link(type="button", (click)="inspectStation(item.original_station_id || item.station_id, item.region_id)") {{displayStationId(item.station_id)}}
                                strong {{item.station_name}}
                                em {{item.pagerank | number:'1.4-4'}}
                            p.empty(*ngIf="!dashboardRank?.rankings?.length") 연결 자료 미확보
                        article.panel.cluster-card
                            h3 K-means 대여소 유형
                            ng-container(*ngTemplateOutlet="clusterPlot")
                        article.panel
                            h3 시간대별 이용 패턴
                            p.panel-note 실제 관측일 × 24시간
                            div.heatmap
                                div.heatmap-row(*ngFor="let row of dashboardExtra?.heatmap")
                                    span {{row.date.slice(5)}}
                                    div.heat-cells
                                        span.heat-cell(*ngFor="let value of row.hours", [style.background]="heatColor(value)", [attr.title]="row.date + ' · ' + value + '건'")
                            p.empty(*ngIf="!dashboardExtra?.heatmap?.length") 시간대 자료 미확보
                    details.panel.legacy-details
                        summary OD 이동 흐름 및 기존 상세 지표
                        p.panel-note 실제 자료 중 상위 연결 · 동일 대여소 출발·도착 제외
                        div.od-table(*ngIf="dashboardNetwork?.available")
                            div.od-row(*ngFor="let edge of dashboardNetwork.edges")
                                span {{displayStationId(edge.origin_station_id)}} → {{displayStationId(edge.destination_station_id)}}
                                strong {{edge.trip_count | number}}건

                section.vulnerability-view(*ngIf="tab === 'vulnerability' && !unprocessed")
                    div.section-heading
                        div
                            h2 취약 구간 & 개선 후보
                            p 실제 이용이 있는 연계 취약 대여소와 개선 순위를 확인합니다.
                    p.error(*ngIf="planningError") {{planningError}}
                    article.panel.planning-panel(*ngIf="planningResult?.available")
                        div.panel-heading
                            h3 신규 대여소 확충 후보
                            span.source-pill 500m 격자 · 주황 음영은 앵커 접근 공백
                        p.panel-note 기존 대여소 300m 밖 · 구·시 인구밀도, 공개 시설, 주변 이용 수요 기준
                        div.planning-city-control
                            label
                                span 분석 도시
                                select([(ngModel)]="scenarioCity", (change)="changeScenarioCity()", aria-label="신규 입지 분석 도시")
                                    option(*ngFor="let city of planningCities()", [value]="city.city") {{nameOf(city.city)}}
                        div.planning-map([id]="mapKey + '-planning'", role="region", aria-label="전체 정류장 커버 영역과 신규 입지 후보 지도", style="height:340px")
                        div.ranking-scroll
                            table.data-table.new-sites-table
                                thead
                                    tr
                                        th 신규 후보
                                        th(*ngIf="scenarioCity !== 'sejong'") 인구밀도(명/km²)
                                        th 시설(500m)
                                        th 주변 대여(1km)
                                        th 최근접 대여소(m)
                                        th 공백 비율
                                tbody
                                    tr(*ngFor="let row of scenarioPlan()?.new_sites | slice:0:10")
                                        td {{row.rank}}위 · {{row.district}}
                                        td(*ngIf="scenarioCity !== 'sejong'") {{row.population_density_km2 | number:'1.0-0'}}
                                        td {{row.facilities_within_500m}}
                                        td {{row.nearby_rentals_1000m | number}}
                                        td {{row.nearest_station_distance_m | number:'1.1-1'}}
                                        td {{percent(row.gap_ratio)}}
                        details.planning-method
                            summary 자료 기준
                            p.panel-note 세종은 동·읍면 경계별 밀도 연결을 검증하지 못해 인구 열과 점수에서 제외하며 시설·주변 대여·공백 비율로 평가합니다. 다른 도시는 2026-10 구·시 밀도이며 실측 격자인구가 아닙니다. 시설은 도서관·공공개방시설 공개 좌표입니다. 경계는 SGIS 2020이며 설치 가능 토지·보행 경로는 별도 확인이 필요합니다.
                        h3.planning-subtitle 후보 선택 시나리오
                        p.panel-note 신규 상위 3곳 · 기존 취약 상위 3곳 조합
                        div.scenario-options
                            label(*ngFor="let row of scenarioPlan()?.scenario_pool")
                                input(type="checkbox", [checked]="selectedSites.includes(row.site_id)", (change)="toggleSite(row.site_id)")
                                | {{row.kind}} {{row.rank}}위 · {{row.district || displayStationId(row.station_id)}}
                        div.scenario-summary(*ngIf="selectedScenario")
                            article
                                span 추가 커버 면적
                                strong {{selectedScenario.added_area_m2 / 1000000 | number:'1.4-4'}} km²
                            article
                                span 후보 간 중복 면적
                                strong {{selectedScenario.overlap_area_m2 / 1000000 | number:'1.4-4'}} km²
                            article
                                span 기준 대비 증가
                                strong {{percent(selectedScenario.increase_ratio)}}
                        p.panel-note 후보300m 추가 연결 가정 · 중복 면적 제외 · 실제 환승·운영 효과 아님
                    article.panel.sensitivity-panel(*ngIf="scenarioPlan()?.sensitivity")
                        div.panel-heading
                            h3 거리·가중치에 따른 순위 안정성
                        p.panel-note 기준: 500m·균등 가중 · 후보가 적으면 점수 대신 거리와 실제 수요를 확인합니다.
                        div.ranking-scroll
